import { Button, HorizontalBox, LineEdit, VerticalBox } from "std-widgets.slint";

export component MainWindow inherits Window {
    in-out property <string> status_text: "Fraggler v2 desktop is ready for Rust engine runs.";
    in-out property <string> log_text: "Rust + Slint desktop shell connected to fraggler-core.\n";
    in-out property <string> analysis_kind: "clonality";
    in-out property <string> input_path: "";
    in-out property <string> output_path: "";
    in-out property <string> last_artifact_path: "";
    in-out property <string> last_run_summary: "No runs yet.";
    in-out property <string> active_hint: "Clonality: use .fsa from IGK/KDE/TCRg-style workflows.";

    callback show_contract();
    callback select_analysis(string);
    callback run_analysis();
    callback browse_input();
    callback browse_output();
    callback clear_log();
    callback open_output();
    callback open_last_artifact();
    callback open_docs();

    title: "Fraggler v2";
    width: 1080px;
    height: 820px;

    VerticalBox {
        padding: 16px;
        spacing: 12px;

        Text {
            text: "Fraggler v2";
            font-size: 28px;
        }

        Text {
            text: "Rust-first rewrite scaffold for offline desktop Fraggler.";
            wrap: word-wrap;
        }

        Rectangle {
            background: #f8fafc;
            border-width: 1px;
            border-color: #dbe2ea;
            border-radius: 10px;
            min-height: 170px;

            VerticalBox {
                padding: 14px;
                spacing: 10px;

                Text {
                    text: "Run Configuration";
                    font-size: 20px;
                }

                Text {
                    text: "Analysis";
                }

                HorizontalBox {
                    spacing: 8px;

                    Button {
                        text: "Clonality";
                        clicked => { root.select_analysis("clonality"); }
                    }

                    Button {
                        text: "FLT3";
                        clicked => { root.select_analysis("flt3"); }
                    }

                    Button {
                        text: "General";
                        clicked => { root.select_analysis("general"); }
                    }

                    Text {
                        text: "Active: " + root.analysis_kind;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    background: #eef2ff;
                    border-width: 1px;
                    border-color: #c7d2fe;
                    border-radius: 8px;
                    height: 42px;
                    Text {
                        x: 10px;
                        y: 11px;
                        text: root.active_hint;
                        wrap: word-wrap;
                        width: parent.width - 20px;
                    }
                }

                Text {
                    text: "Input .fsa file";
                }

                HorizontalBox {
                    spacing: 8px;

                    LineEdit {
                        text <=> root.input_path;
                    }

                    Button {
                        text: "Browse";
                        clicked => { root.browse_input(); }
                    }
                }

                Text {
                    text: "Output directory";
                }

                HorizontalBox {
                    spacing: 8px;

                    LineEdit {
                        text <=> root.output_path;
                    }

                    Button {
                        text: "Browse";
                        clicked => { root.browse_output(); }
                    }
                }
            }
        }

        HorizontalBox {
            spacing: 8px;

            Button {
                text: "Run Analysis";
                clicked => { root.run_analysis(); }
            }

            Button {
                text: "Show Contract";
                clicked => { root.show_contract(); }
            }

            Button {
                text: "Open Docs";
                clicked => { root.open_docs(); }
            }

            Button {
                text: "Open Output";
                clicked => { root.open_output(); }
            }

            Button {
                text: "Open Artifact";
                clicked => { root.open_last_artifact(); }
            }

            Button {
                text: "Clear Log";
                clicked => { root.clear_log(); }
            }
        }

        Rectangle {
            background: #f3f4f6;
            border-width: 1px;
            border-color: #d1d5db;
            height: 52px;
            Text {
                x: 12px;
                y: 14px;
                text: root.status_text;
                wrap: word-wrap;
                width: parent.width - 24px;
            }
        }

        Rectangle {
            background: #ecfeff;
            border-width: 1px;
            border-color: #a5f3fc;
            height: 44px;
            Text {
                x: 12px;
                y: 12px;
                text: "Last run: " + root.last_run_summary;
                wrap: word-wrap;
                width: parent.width - 24px;
            }
        }

        Rectangle {
            background: #eef2ff;
            border-width: 1px;
            border-color: #c7d2fe;
            height: 44px;
            Text {
                x: 12px;
                y: 12px;
                text: "Last artifact: " + root.last_artifact_path;
                wrap: word-wrap;
                width: parent.width - 24px;
            }
        }

        Rectangle {
            background: #111827;
            border-radius: 8px;
            border-width: 1px;
            border-color: #374151;
            height: 520px;

            Text {
                x: 12px;
                y: 12px;
                width: parent.width - 24px;
                text: root.log_text;
                color: #f9fafb;
                wrap: word-wrap;
            }
        }
    }
}
